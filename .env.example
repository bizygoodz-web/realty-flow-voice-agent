# Server Configuration
PORT=3000
NODE_ENV=development

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Emotion Detection API
EMOTION_API_ENDPOINT=https://api.example.com/emotion
EMOTION_API_KEY=your_emotion_api_key

# Database Configuration (if using)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=realty_flow
DB_USER=postgres
DB_PASSWORD=your_password

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# AI/ML Configuration
AI_MODEL_ENDPOINT=https://api.example.com/ai
AI_MODEL_KEY=your_ai_model_key

# Security
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# External Services
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_KEY_FILE=path/to/keyfile.json
